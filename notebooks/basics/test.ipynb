    "import numpy as np\n",
    "\n",
    "T1 = np.ones((50, 50))\n",
    "T2 = np.ones((50, 50))\n",
    "alpha = 1\n",
    "f0 = 1\n",
    "field_map = np.zeros((50, 50))\n",
    "M0 = np.ones((50, 50))\n",
    "phi = 0\n",
    "inputs = [T1, T2, alpha, f0, -field_map, M0, phi]\n",
    "broadcast_shape = np.broadcast(*inputs).shape\n",
    "print(broadcast_shape)"
   ]
  }
